# URL of the FastAPI backend (Cloud Run). deploy.sh prints it.
BACKEND_URL=https://clipsafe-api-123456789.us-central1.run.app
# Shared key the backend checks in X-API-Key (deploy.sh stores it in Secret Manager
# and writes it to secrets/vercel.env when FRONTEND_HOST=vercel).
BACKEND_API_KEY=
# Public URL of this frontend, used for the OAuth redirect URI.
APP_URL=http://localhost:3000
# 32+ random characters; encrypts the session cookies. `openssl rand -base64 48`
SESSION_SECRET=
# Password for the dashboard login (keeps strangers from spending your GCP credits).
APP_PASSWORD=
# OAuth 2.0 Web client (APIs & Services > Credentials). Redirect URI:
#   ${APP_URL}/api/youtube/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
